+    if (CMAKE_SYSTEM_NAME STREQUAL "iOS" AND TARGET dawn_system_utils)
+      set_target_properties(dawn_system_utils PROPERTIES XCODE_ATTRIBUTE_CLANG_ENABLE_OBJC_ARC "NO")
+    endif()
   endif()
 
