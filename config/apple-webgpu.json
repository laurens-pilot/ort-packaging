{
  "build_osx_archs": {
    "iphoneos": ["arm64"],
    "iphonesimulator": ["arm64"]
  },
  "build_params": {
    "base": [
      "--parallel",
      "--use_xcode",
      "--build_apple_framework",
      "--use_coreml",
      "--use_xnnpack",
      "--use_webgpu",
      "--skip_tests",
      "--disable_rtti",
      "--enable_lto",
      "--cmake_extra_defines=onnxruntime_BUILD_UNIT_TESTS=OFF"
    ],
    "iphoneos": ["--ios", "--apple_deploy_target=16.3"],
    "iphonesimulator": ["--ios", "--apple_deploy_target=16.3"]
  }
}
